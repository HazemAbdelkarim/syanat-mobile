rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ======================
    // USERS
    // ======================
    match /users/{userId} {
      // Public read for technicians only (active technicians list)
      allow read: if resource.data.role == 'technician';

      // User can read himself
      allow read: if signedIn() && request.auth.uid == userId;

      // Admin can read everyone
      allow read: if isAdmin();

      // User can write himself
      allow write: if signedIn() && request.auth.uid == userId;

      // Admin can write everyone (CREATE / UPDATE / DELETE)
      allow write: if isAdmin();
    }

    // ======================
    // SERVICES (PUBLIC)
    // ======================
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ======================
    // JOBS
    // ======================
    match /jobs/{jobId} {
      // Any signed-in user can create a job
      allow create: if signedIn();

      // Read / update by owner (customer or technician) OR admin
      allow read, update, delete: if signedIn() &&
        (request.auth.uid == resource.data.customerId ||
         request.auth.uid == resource.data.technicianId ||
         isAdmin());
    }

    // ======================
    // PAYMENTS
    // ======================
    match /payments/{paymentId} {
      // User can create a payment for themselves
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;

      // User can read their own payments
      allow read: if signedIn() &&
        resource.data.userId == request.auth.uid;

      // User can update their own PENDING payment (e.g. link orderId, upload screenshot)
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'PENDING';

      // Admin can read and update all payments (confirm/reject)
      allow read, update: if isAdmin();
    }

    // ======================
    // CHATS
    // ======================
    match /chats/{chatId} {
      // Normal chat access
      allow read, create: if signedIn();

      // Admin can read/write any chat metadata if you need
      allow read, write: if isAdmin();

      match /messages/{messageId} {
        // Participants can read/create
        allow read, create: if signedIn();

        // Admin can read/write any message (for moderation / audits)
        allow read, write: if isAdmin();
      }
    }

    // ======================
    // INVENTORY (ADMIN ONLY)
    // ======================
    match /inventory/{docId} {
      allow read, write: if isAdmin();
    }

    // ======================
    // STATS
    // ======================
    match /stats/{docId} {
      allow read: if isAdmin();
      allow write: if signedIn();
    }

    // ======================
    // DEFAULT DENY
    // ======================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
